{
  "rewrites": [
    {
      "source": "/koenig-api/:path*",
      "destination": "/api/proxy/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notify?type=weekly_report",
      "schedule": "30 2 * * 1"
    }
  ]
}
